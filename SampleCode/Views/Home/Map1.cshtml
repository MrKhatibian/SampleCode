@{
    ViewBag.Title = "Map";
}
<head>
    <title> ArcGIS api 4.30</title>

    <style>
        #mapView {
            padding: 0;
            margin: 0;
            height: 75vh;
            width: 100%;
        }
    </style>
    <script type="module" src="~/Scripts/EsriSampleCode/Map1.js"></script>    
</head>

<body>
    <div class="row justify-content-start">
        <div class="col-4 w-auto">
            <button class="btn btn-primary" type="submit" id="btnSabtDarkhast">SabtDarkhast</button>
            <button class="btn btn-warning" type="submit" id="testConnection">TestConnection</button>
            <button class="btn btn-warning" type="submit" id="btnStartProgressbar">Progressbar</button>
            <button id="btnUpdateXYDarkhast" style="color:orangered; border:none" class="esri-widget esri-widget--button  esri-interactive" title="آپدیت مختصات درخواست">
                <calcite-icon icon="layer-points" scale="s" />
            </button>

        </div>
    </div>
    <div class="row progress mt-2" id="divProgressbar" >
        <div id="progressbar1" class="progress-bar progress-bar-striped bg-success progress-bar-animated" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100" style="width: 0%">0%</div>
    </div>
    <div class="row progress mt-2" id="divProgressbar" >
        <div id="progressbar2" class="progress-bar progress-bar-striped bg-info progress-bar-animated" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100" style="width: 0%">0%</div>
    </div>
    <div class="row progress mt-2" id="divProgressbar" >
        <div id="progressbar3" class="progress-bar progress-bar-striped bg-warning progress-bar-animated" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100" style="width: 0%">0%</div>
    </div>
    <div class="row mt-2">
        <div class="col" id="mapView"></div>
    </div>
    <script>
        
        
    </script>
</body>