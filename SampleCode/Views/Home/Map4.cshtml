@{
    ViewBag.Title = "Map";
}
<head>
    <title> ArcGIS api 4.30</title>
    <style>
        #contFilter {
            direction: rtl;
        }

        #map {
            height: 100%;
        }

        #attributeTable {
            height: 50vh;
            direction: ltr;
        }
    </style>
    <script>
        // Must be at the very top, before imports
        window.dojoConfig = {
            locale: "en"  // or "ar" for Arabic
        };
    </script>
    <script type="module" src="~/Scripts/EsriSampleCode/Map4.js"></script>
    
</head>

<body class="p-4">
    <div id="contFilter" class="container">
        <div class="row h-25">
            <div class="col-4">
                <!-- فیلترها -->
                <h5>فیلترها</h5>
                <div class="row align-items-start">
                    <div class="row">
                        <div class="col">
                            <div class="row">
                                <label class="form-label">براساس تاریخ:</label>
                            </div>
                            <div class="row">
                                <div class="form-check form-check-inline col">
                                    <input class="form-check-input" type="checkbox" id="checKartabl" checked>
                                    <label class="form-check-label" for="checKartabl">ارسال به کارتابل</label>
                                </div>
                                <div class="form-check form-check-inline col">
                                    <input class="form-check-input" type="checkbox" id="checDarkhast">
                                    <label class="form-check-label" for="checDarkhast">درخواست</label>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <label class="form-label">تاریخ شروع:</label>
                            <input class="form-control" type="date" id="startDateSend">                           
                        </div>
                        <div class="col-6">
                            <label class="form-label">تاریخ پایان:</label>
                            <input class="form-control" type="date" id="endDateSend">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <label class="form-label">نوع درخواست:</label>
                            <select class="form-select" id="comboNoeDarkhast"></select>
                        </div>
                        <div class="col">
                            <label class="form-label">مرحله:</label>
                            <select class="form-select" id="comboMarhale"></select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <label class="form-label">نوع کاربری:</label>
                            <select class="form-select" id="comboNoeKarbari"></select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <label class="form-label">منطقه:</label>
                            <select class="form-select" id="comboMantaghe"></select>
                        </div>
                        <div class="col">
                            <label class="form-label">محدوده:</label>
                            <select class="form-select" id="comboMahdodeh"></select>
                        </div>
                    </div>
                </div>

            </div>
            <!--نقشه-->
            <div class="col-8 pb-5">
                <div class="row">
                    <h5 class="col">نقشه</h5>                    
                </div>
                <div id="map"></div>
                <div id="btnLinkMap2Table" style="color:red" class="esri-widget esri-widget--button  esri-interactive" title="Linked Map to Table">                    
                    <calcite-icon icon="offline" scale="s" />
                </div>
            </div>
        </div>
        <div class="row mt-2 justify-content-center">
            <div class="col-4 w-auto">
                <button class="btn btn-primary" type="submit" id="btnCSV">خروجی CSV</button>
                <button class="btn btn-primary" type="submit" id="btnExcel">خروجی Excel</button>
                <button class="btn btn-primary" type="submit" id="btnMapScreenshot">خروجی تصویر نقشه</button>
                <button class="btn btn-danger" type="submit" id="btnClearFilters">پاک کردن فیلترها</button>
            </div>
        </div>
        <!--جدول اطلاعات-->
        <div class="row pt-3">
            <div class="col-md-12" id="divAttr">
                @*<h5>جدول اطلاعات</h5>*@
                <div id="attributeTable"></div>
            </div>
        </div>
    </div>    
</body>

